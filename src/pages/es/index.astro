---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  lang="es"
  title="Business Feasibility Toolkit - Evalua tu idea de negocio"
  description="Calculadoras web gratuitas para evaluar la factibilidad de tu negocio: punto de equilibrio, VAN, TIR y mas."
>
  <h1>Evalua la factibilidad de tu negocio</h1>
  <p>
    Calculadoras web gratuitas y bilingues para validar tu idea antes de
    invertir: punto de equilibrio, flujo de caja, VAN, TIR y mas.
  </p>
  <p>
    <a class="btn" href={`${base}es/calculadoras/`}>Empezar ahora</a>
    <a href={`${base}en/`} lang="en">Switch to English</a>
  </p>

  <section class="card" aria-label="Calculadoras">
    <h2>Calculadoras</h2>
    <p>
      <a href={`${base}es/calculadoras/`}>Ver las 7 calculadoras</a> - sin registro,
      100% en tu navegador.
    </p>
  </section>
</BaseLayout>
