---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CalcPage from "../../../components/CalcPage.astro";
import NpvIrrCalc from "../../../components/react/NpvIrrCalc";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  lang="es"
  title="Paso 6: VPN y TIR — Calculadoras"
  description="Si tu inversion se recupera y cuanto rinde al ano."
>
  <CalcPage
    lang="es"
    step={6}
    stepName="Proyecta tu dinero"
    lede="Si tu inversion se recupera y cuanto rinde al ano."
    prevHref={`${base}es/calculadoras/flujo-caja/`}
    prevLabel="Paso 6: tu flujo"
    nextHref={`${base}es/calculadoras/cac-ltv/`}
    nextLabel="Paso 7: cada cliente"
  >
    <NpvIrrCalc lang="es" currency="MXN" client:load />
  </CalcPage>
</BaseLayout>
