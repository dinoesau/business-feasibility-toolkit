---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CalcPage from "../../../components/CalcPage.astro";
import TamSamSomCalc from "../../../components/react/TamSamSomCalc";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  lang="es"
  title="Paso 2: mide tu mercado — Calculadoras"
  description="Cuantos podrian comprarte, a cuantos llegas y cuantos ganas."
>
  <CalcPage
    lang="es"
    step={2}
    stepName="Mide tu mercado"
    lede="Cuantos podrian comprarte, a cuantos puedes llegar y cuantos puedes ganar."
    prevHref={`${base}es/calculadoras/`}
    prevLabel="Calculadoras"
    nextHref={`${base}es/calculadoras/costo-producto/`}
    nextLabel="Paso 3: tu costo"
  >
    <TamSamSomCalc lang="es" currency="MXN" client:load />
  </CalcPage>
</BaseLayout>
