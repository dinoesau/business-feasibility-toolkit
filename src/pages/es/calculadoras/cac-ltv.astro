---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CalcPage from "../../../components/CalcPage.astro";
import CacLtvCalc from "../../../components/react/CacLtvCalc";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  lang="es"
  title="Paso 7: revisa cada cliente — Calculadoras"
  description="Cada cliente debe dejar al menos 3 veces lo que costo traerlo."
>
  <CalcPage
    lang="es"
    step={7}
    stepName="Revisa cada cliente"
    lede="Cada cliente debe dejar al menos 3 veces lo que costo traerlo."
    prevHref={`${base}es/calculadoras/vpn-tir/`}
    prevLabel="Paso 6: VPN y TIR"
    nextHref={`${base}es/calculadoras/sensibilidad/`}
    nextLabel="Paso 8: mueve numeros"
  >
    <CacLtvCalc lang="es" currency="MXN" client:load />
  </CalcPage>
</BaseLayout>
