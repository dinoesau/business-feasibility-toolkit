---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CalcPage from "../../../components/CalcPage.astro";
import PricingCalc from "../../../components/react/PricingCalc";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  lang="es"
  title="Paso 4: pon tu precio — Calculadoras"
  description="Un precio que pague tus costos, deje ganancia y la gente pague."
>
  <CalcPage
    lang="es"
    step={4}
    stepName="Pon tu precio"
    lede="Un precio que pague tus costos, te deje ganancia y la gente si pague."
    prevHref={`${base}es/calculadoras/costo-producto/`}
    prevLabel="Paso 3: tu costo"
    nextHref={`${base}es/calculadoras/punto-equilibrio/`}
    nextLabel="Paso 5: tu equilibrio"
  >
    <PricingCalc lang="es" currency="MXN" client:load />
  </CalcPage>
</BaseLayout>
