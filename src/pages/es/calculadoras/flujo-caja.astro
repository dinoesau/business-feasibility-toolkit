---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CalcPage from "../../../components/CalcPage.astro";
import CashflowCalc from "../../../components/react/CashflowCalc";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  lang="es"
  title="Paso 6: proyecta tu dinero — Calculadoras"
  description="Tu dinero mes a mes y hasta cuando alcanza."
>
  <CalcPage
    lang="es"
    step={6}
    stepName="Proyecta tu dinero"
    lede="Tu dinero mes a mes y hasta cuando alcanza. Sin sorpresas."
    prevHref={`${base}es/calculadoras/punto-equilibrio/`}
    prevLabel="Paso 5: tu equilibrio"
    nextHref={`${base}es/calculadoras/vpn-tir/`}
    nextLabel="Paso 6: VPN y TIR"
  >
    <CashflowCalc lang="es" currency="MXN" client:load />
  </CalcPage>
</BaseLayout>
