---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const calcs = [
  { slug: "tam-sam-som", paso: "Paso 2", name: "TAM / SAM / SOM", desc: "Cuantos podrian comprarte." },
  { slug: "costo-producto", paso: "Paso 3", name: "Costo de producto", desc: "Tu costo real con IVA e ISR." },
  { slug: "pricing", paso: "Paso 4", name: "Precio por margen", desc: "A que precio vender." },
  { slug: "punto-equilibrio", paso: "Paso 5", name: "Punto de equilibrio", desc: "Piezas para no perder." },
  { slug: "flujo-caja", paso: "Paso 6", name: "Flujo de caja", desc: "Tu dinero mes a mes." },
  { slug: "vpn-tir", paso: "Paso 6", name: "VPN / TIR", desc: "Si la inversion se recupera." },
  { slug: "cac-ltv", paso: "Paso 7", name: "CAC / LTV", desc: "Si cada cliente deja dinero." },
  { slug: "sensibilidad", paso: "Paso 8", name: "Sensibilidad", desc: "Si algo sale mal." },
];
---

<BaseLayout
  lang="es"
  title="Calculadoras — Business Feasibility Toolkit"
  description="8 calculadoras gratis para revisar tu idea. Sin cuentas, en tu navegador."
>
  <section class="rts-hero">
    <h1>Ocho calculadoras, una por pregunta</h1>
    <p class="rts-lede">Gratis y sin cuentas. Todo se calcula en tu navegador.</p>
  </section>
  <section style="padding-bottom: 6rem">
    <div class="rts-grid3">
      {calcs.map((c) => (
        <a class="rts-card" href={`${base}es/calculadoras/${c.slug}/`}>
          <span class="rts-badge">{c.paso}</span>
          <h3>{c.name}</h3>
          <p>{c.desc}</p>
          <span class="rts-go">Calcular →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
