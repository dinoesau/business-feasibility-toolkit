---
const base = Astro.base;
const calcs = [
  { slug: 'tam-sam-som', name: 'TAM / SAM / SOM', desc: 'Dimensiona tu mercado total, alcanzable y obtenible.' },
  { slug: 'punto-equilibrio', name: 'Punto de equilibrio', desc: 'Unidades para no perder ni ganar.' },
  { slug: 'vpn-tir', name: 'VPN / TIR', desc: '¿La inversión crea valor?' },
  { slug: 'pricing', name: 'Precio por margen', desc: 'Del costo al precio con tu margen.' },
  { slug: 'cac-ltv', name: 'CAC / LTV', desc: '¿Tu adquisición es rentable? Regla ≥ 3.' },
  { slug: 'flujo-caja', name: 'Flujo de caja', desc: 'Saldo mes a mes y runway.' },
  { slug: 'sensibilidad', name: 'Sensibilidad', desc: 'Qué pasa si el precio varía ±20%.' },
];
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Calculadoras — Business Feasibility Toolkit</title>
  </head>
  <body style="font-family: Inter, sans-serif; background: #faf9f5; color: #141413; margin: 0;">
    <main style="max-width: 1200px; margin: 0 auto; padding: 48px 24px 96px;">
      <p><a href={`${base}en/calculators/`} style="color: #cc785c; font-size: 14;">English version →</a></p>
      <h1 style="font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400; font-size: 48px; letter-spacing: -1px; margin: 8px 0;">Calculadoras de factibilidad</h1>
      <p style="color: #3d3d3a; max-width: 720px; line-height: 1.55;">7 herramientas, 3 entradas máximo cada una, resultado instantáneo. Sin registro, 100% en tu navegador.</p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-top: 32px;">
        {calcs.map((c) => (
          <a href={`${base}es/calculadoras/${c.slug}/`} style="background: #efe9de; border-radius: 12px; padding: 32px; text-decoration: none; color: #141413; display: block;">
            <h2 style="font-size: 18px; font-weight: 500; margin: 0 0 8px;">{c.name}</h2>
            <p style="color: #3d3d3a; font-size: 16px; line-height: 1.55; margin: 0 0 12px;">{c.desc}</p>
            <span style="color: #cc785c; font-size: 14px; font-weight: 500;">Calcular →</span>
          </a>
        ))}
      </div>
    </main>
  </body>
</html>
