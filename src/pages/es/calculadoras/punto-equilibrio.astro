---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CalcPage from "../../../components/CalcPage.astro";
import BreakEvenCalc from "../../../components/react/BreakEvenCalc";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  lang="es"
  title="Paso 5: halla tu equilibrio — Calculadoras"
  description="Cuantas piezas al mes debes vender para no perder."
>
  <CalcPage
    lang="es"
    step={5}
    stepName="Halla tu equilibrio"
    lede="Cuantas piezas debes vender al mes para no perder. Solo 3 numeros."
    prevHref={`${base}es/calculadoras/pricing/`}
    prevLabel="Paso 4: tu precio"
    nextHref={`${base}es/calculadoras/flujo-caja/`}
    nextLabel="Paso 6: tu dinero"
  >
    <BreakEvenCalc lang="es" currency="MXN" client:load />
  </CalcPage>
</BaseLayout>
