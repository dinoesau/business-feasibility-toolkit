---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CalcPage from "../../../components/CalcPage.astro";
import ResumenForm from "../../../components/react/ResumenForm";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  lang="es"
  title="Paso 10: llena tu resumen y guarda el PDF — Plantillas"
  description="Llena tu resumen ejecutivo en el navegador y guardalo como PDF. Sin cuentas, sin Overleaf."
>
  <style>
    .doc-sheet {
      background: #fff;
      color: #141413;
      border: 1px solid var(--hairline);
      border-radius: 0.75rem;
      padding: 2rem;
    }
    .doc-sheet h3 { color: #141413; }
    @media print {
      header.topnav,
      footer,
      .rts-stepbar,
      .rts-lede,
      .doc-form,
      .rts-actions,
      .rts-pager,
      #btn-done {
        display: none !important;
      }
      main.wrap { max-width: none; padding: 0; }
      .rts-grid.doc-grid { display: block; margin: 0; }
      .doc-sheet { border: 0; border-radius: 0; padding: 0; }
    }
  </style>
  <CalcPage
    lang="es"
    step={10}
    stepName="Llena tu resumen"
    lede="Llena las 11 secciones y dale a Guardar PDF. Solo sale la hoja, no el formulario."
    prevHref={`${base}es/calculadoras/sensibilidad/`}
    prevLabel="Paso 8: mueve los numeros"
    nextHref={`${base}es/plantillas/`}
    nextLabel="Ver todas las plantillas"
  >
    <ResumenForm lang="es" client:load />
  </CalcPage>
</BaseLayout>
