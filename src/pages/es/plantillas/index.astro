---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const docs = [
  { slug: '01-estudio-factibilidad', name: 'Estudio de factibilidad', desc: 'Mercado, técnico-operativo, legal MX, organizacional, financiero (VAN/TIR), ambiental-social, riesgos y matriz Go/No-Go.' },
  { slug: '02-plan-negocios', name: 'Plan de negocios', desc: 'Estructura SBA + SCORE + narrativa Sequoia: TAM/SAM/SOM, modelo de negocio, roadmap, financiamiento y proyecciones.' },
  { slug: '03-resumen-ejecutivo', name: 'Resumen ejecutivo (2 páginas)', desc: 'Página 1 narrativa de valor, página 2 datos y solicitud. El límite de 2 páginas es intencional.' },
  { slug: '04-pitch-deck', name: 'Pitch deck (12 slides)', desc: 'Beamer listo para presentar: problema, solución, por qué ahora, mercado, equipo, finanzas y solicitud.' },
];
---

<BaseLayout
  lang="es"
  title="Plantillas LaTeX — Business Feasibility Toolkit"
  description="Plantillas LaTeX bilingües ES/EN listas para Overleaf: estudio de factibilidad, plan de negocios, resumen ejecutivo y pitch deck."
>
  <p><a href={`${base}en/templates/`} style="color: #cc785c; font-size: 14;">English version →</a></p>
  <h1 style="font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400; font-size: 48px; letter-spacing: -1px; margin: 8px 0;">Plantillas LaTeX</h1>
  <p style="color: #3d3d3a; max-width: 720px; line-height: 1.55;">Overleaf-ready y compilables con latexmk. Bilingües ES/EN. Suba el ZIP a Overleaf (New Project → Upload), elija el <code>main-*.tex</code> como Main document y recompile.</p>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-top: 32px;">
    {docs.map((d) => (
      <div style="background: #efe9de; border-radius: 12px; padding: 32px;">
        <h2 style="font-size: 18px; font-weight: 500; margin: 0 0 8px;">{d.name}</h2>
        <p style="color: #3d3d3a; font-size: 16px; line-height: 1.55; margin: 0 0 12px;">{d.desc}</p>
        <p style="margin: 0; display: flex; gap: 16px; font-size: 14px; font-weight: 500;">
          <a href={`${base}plantillas/${d.slug}-es.zip`} style="color: #cc785c;">Descargar ES ↓</a>
          <a href={`${base}plantillas/${d.slug}-en.zip`} style="color: #cc785c;">Download EN ↓</a>
        </p>
      </div>
    ))}
  </div>
  <p style="margin-top: 32px; color: #3d3d3a; font-size: 16px;">Muestra compilada: <a href={`${base}plantillas/muestra-resumen-ejecutivo-es.pdf`} style="color: #cc785c;">resumen ejecutivo ES (PDF)</a>. Fuentes y guía Overleaf en <code>templates/latex/</code>.</p>
</BaseLayout>
