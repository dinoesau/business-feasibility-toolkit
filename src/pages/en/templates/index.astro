---
const base = import.meta.env.BASE_URL;
const docs = [
  { slug: '01-estudio-factibilidad', name: 'Feasibility study', desc: 'Market, technical-operational, MX legal, organizational, financial (NPV/IRR), environmental-social, risks and a Go/No-Go matrix.' },
  { slug: '02-plan-negocios', name: 'Business plan', desc: 'SBA + SCORE structure with Sequoia narrative: TAM/SAM/SOM, business model, roadmap, funding and projections.' },
  { slug: '03-resumen-ejecutivo', name: 'Executive summary (2 pages)', desc: 'Page 1 value narrative, page 2 figures and ask. The 2-page limit is intentional.' },
  { slug: '04-pitch-deck', name: 'Pitch deck (12 slides)', desc: 'Presentation-ready beamer: problem, solution, why now, market, team, financials and ask.' },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>LaTeX Templates — Business Feasibility Toolkit</title>
  </head>
  <body style="font-family: Inter, sans-serif; background: #faf9f5; color: #141413; margin: 0;">
    <main style="max-width: 1200px; margin: 0 auto; padding: 48px 24px 96px;">
      <p><a href={`${base}es/plantillas/`} style="color: #cc785c; font-size: 14;">Versión en español →</a></p>
      <h1 style="font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400; font-size: 48px; letter-spacing: -1px; margin: 8px 0;">LaTeX templates</h1>
      <p style="color: #3d3d3a; max-width: 720px; line-height: 1.55;">Fill your summary online and save it as PDF, or upload the ZIP to Overleaf for the formal finish. Bilingual ES/EN.</p>
      <p style="margin-top: 16px;"><a href={`${base}en/templates/summary/`} style="background: #cc785c; color: #fff; border-radius: 8px; padding: 12px 20px; font-size: 14px; font-weight: 500; text-decoration: none;">Fill summary and save PDF →</a></p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-top: 32px;">
        {docs.map((d) => (
          <div style="background: #efe9de; border-radius: 12px; padding: 32px;">
            <h2 style="font-size: 18px; font-weight: 500; margin: 0 0 8px;">{d.name}</h2>
            <p style="color: #3d3d3a; font-size: 16px; line-height: 1.55; margin: 0 0 12px;">{d.desc}</p>
            <p style="margin: 0; display: flex; gap: 16px; font-size: 14px; font-weight: 500;">
              <a href={`${base}plantillas/${d.slug}-es.zip`} style="color: #cc785c;">Descargar ES ↓</a>
              <a href={`${base}plantillas/${d.slug}-en.zip`} style="color: #cc785c;">Download EN ↓</a>
            </p>
          </div>
        ))}
      </div>
      <p style="margin-top: 32px; color: #3d3d3a; font-size: 16px;">Compiled sample: <a href={`${base}plantillas/muestra-resumen-ejecutivo-es.pdf`} style="color: #cc785c;">executive summary ES (PDF)</a>. Sources and Overleaf guide in <code>templates/latex/</code>.</p>
    </main>
  </body>
</html>
