---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CalcPage from "../../../components/CalcPage.astro";
import ResumenForm from "../../../components/react/ResumenForm";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  lang="en"
  title="Step 10: fill your summary and save the PDF — Templates"
  description="Fill your executive summary in the browser and save it as PDF. No accounts, no Overleaf."
>
  <style>
    .doc-sheet {
      background: #fff;
      color: #141413;
      border: 1px solid var(--hairline);
      border-radius: 0.75rem;
      padding: 2rem;
    }
    .doc-sheet h3 { color: #141413; }
    @media print {
      header.topnav,
      footer,
      .rts-stepbar,
      .rts-lede,
      .doc-form,
      .rts-actions,
      .rts-pager,
      #btn-done {
        display: none !important;
      }
      main.wrap { max-width: none; padding: 0; }
      .rts-grid.doc-grid { display: block; margin: 0; }
      .doc-sheet { border: 0; border-radius: 0; padding: 0; }
    }
  </style>
  <CalcPage
    lang="en"
    step={10}
    stepName="Fill your summary"
    lede="Fill the 11 sections and hit Save PDF. Only the sheet prints, not the form."
    prevHref={`${base}en/calculators/sensitivity/`}
    prevLabel="Step 8: stress-test"
    nextHref={`${base}en/templates/`}
    nextLabel="See all templates"
  >
    <ResumenForm lang="en" client:load />
  </CalcPage>
</BaseLayout>
