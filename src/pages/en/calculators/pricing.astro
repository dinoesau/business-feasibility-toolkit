---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CalcPage from "../../../components/CalcPage.astro";
import PricingCalc from "../../../components/react/PricingCalc";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  lang="en"
  title="Step 4: set your price — Calculators"
  description="A price that covers costs, leaves profit, and people pay."
>
  <CalcPage
    lang="en"
    step={4}
    stepName="Set your price"
    lede="A price that covers your costs, leaves profit, and people will pay."
    prevHref={`${base}en/calculators/product-cost/`}
    prevLabel="Step 3: your cost"
    nextHref={`${base}en/calculators/break-even/`}
    nextLabel="Step 5: break-even"
  >
    <PricingCalc lang="en" currency="USD" client:load />
  </CalcPage>
</BaseLayout>
