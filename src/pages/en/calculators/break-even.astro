---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CalcPage from "../../../components/CalcPage.astro";
import BreakEvenCalc from "../../../components/react/BreakEvenCalc";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  lang="en"
  title="Step 5: break-even — Calculators"
  description="How many units a month you must sell to stop losing."
>
  <CalcPage
    lang="en"
    step={5}
    stepName="Break-even"
    lede="How many units you must sell a month to stop losing. Just 3 numbers."
    prevHref={`${base}en/calculators/pricing/`}
    prevLabel="Step 4: your price"
    nextHref={`${base}en/calculators/cash-flow/`}
    nextLabel="Step 6: your cash"
  >
    <BreakEvenCalc lang="en" currency="USD" client:load />
  </CalcPage>
</BaseLayout>
