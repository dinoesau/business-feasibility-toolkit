---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CalcPage from "../../../components/CalcPage.astro";
import NpvIrrCalc from "../../../components/react/NpvIrrCalc";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  lang="en"
  title="Step 6: NPV and IRR — Calculators"
  description="Whether your investment pays back and what it yields a year."
>
  <CalcPage
    lang="en"
    step={6}
    stepName="Your cash"
    lede="Whether your investment pays back and what it yields a year."
    prevHref={`${base}en/calculators/cash-flow/`}
    prevLabel="Step 6: your cash flow"
    nextHref={`${base}en/calculators/cac-ltv/`}
    nextLabel="Step 7: each customer"
  >
    <NpvIrrCalc lang="en" currency="USD" client:load />
  </CalcPage>
</BaseLayout>
