---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CalcPage from "../../../components/CalcPage.astro";
import SensitivityCalc from "../../../components/react/SensitivityCalc";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  lang="en"
  title="Step 8: move the numbers — Calculators"
  description="What if costs rise, you sell less, or you cut the price."
>
  <CalcPage
    lang="en"
    step={8}
    stepName="Move the numbers"
    lede="What if something goes wrong. Make your plan survive it."
    prevHref={`${base}en/calculators/cac-ltv/`}
    prevLabel="Step 7: each customer"
    nextHref={`${base}en/templates/`}
    nextLabel="Step 10: templates"
  >
    <SensitivityCalc lang="en" currency="USD" client:load />
  </CalcPage>
</BaseLayout>
