---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const calcs = [
  { slug: "tam-sam-som", paso: "Step 2", name: "TAM / SAM / SOM", desc: "How big your true market is." },
  { slug: "product-cost", paso: "Step 3", name: "Product cost", desc: "Your true cost, all included." },
  { slug: "pricing", paso: "Step 4", name: "Margin pricing", desc: "What price to charge." },
  { slug: "break-even", paso: "Step 5", name: "Break-even", desc: "Units to stop losing." },
  { slug: "cash-flow", paso: "Step 6", name: "Cash flow", desc: "Your money month by month." },
  { slug: "npv-irr", paso: "Step 6", name: "NPV / IRR", desc: "Whether it pays back." },
  { slug: "cac-ltv", paso: "Step 7", name: "CAC / LTV", desc: "Whether each customer pays." },
  { slug: "sensitivity", paso: "Step 8", name: "Sensitivity", desc: "If something goes wrong." },
];
---

<BaseLayout
  lang="en"
  title="Calculators — Business Feasibility Toolkit"
  description="8 free calculators to test your idea. No accounts, in your browser."
>
  <section class="rts-hero">
    <h1>Eight calculators, one per question</h1>
    <p class="rts-lede">Free, no accounts. Everything runs in your browser.</p>
  </section>
  <section style="padding-bottom: 6rem">
    <div class="rts-grid3">
      {calcs.map((c) => (
        <a class="rts-card" href={`${base}en/calculators/${c.slug}/`}>
          <span class="rts-badge">{c.paso}</span>
          <h3>{c.name}</h3>
          <p>{c.desc}</p>
          <span class="rts-go">Calculate →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
