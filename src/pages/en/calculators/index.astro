---
const base = import.meta.env.BASE_URL;
const calcs = [
  { slug: 'tam-sam-som', name: 'TAM / SAM / SOM', desc: 'Size your total, serviceable, obtainable market.' },
  { slug: 'break-even', name: 'Break-even', desc: 'Units to stop losing money.' },
  { slug: 'npv-irr', name: 'NPV / IRR', desc: 'Does the investment create value?' },
  { slug: 'pricing', name: 'Margin pricing', desc: 'From cost to price with your margin.' },
  { slug: 'cac-ltv', name: 'CAC / LTV', desc: 'Is acquisition profitable? Rule ≥ 3.' },
  { slug: 'cash-flow', name: 'Cash flow', desc: 'Month-by-month balance and runway.' },
  { slug: 'sensitivity', name: 'Sensitivity', desc: 'What if price moves ±20%?' },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Calculators — Business Feasibility Toolkit</title>
  </head>
  <body style="font-family: Inter, sans-serif; background: #faf9f5; color: #141413; margin: 0;">
    <main style="max-width: 1200px; margin: 0 auto; padding: 48px 24px 96px;">
      <p><a href={`${base}es/calculadoras/`} style="color: #cc785c; font-size: 14;">Versión en español →</a></p>
      <h1 style="font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400; font-size: 48px; letter-spacing: -1px; margin: 8px 0;">Feasibility calculators</h1>
      <p style="color: #3d3d3a; max-width: 720px; line-height: 1.55;">7 tools, max 3 inputs each, instant results. No signup, 100% in your browser.</p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-top: 32px;">
        {calcs.map((c) => (
          <a href={`${base}en/calculators/${c.slug}/`} style="background: #efe9de; border-radius: 12px; padding: 32px; text-decoration: none; color: #141413; display: block;">
            <h2 style="font-size: 18px; font-weight: 500; margin: 0 0 8px;">{c.name}</h2>
            <p style="color: #3d3d3a; font-size: 16px; line-height: 1.55; margin: 0 0 12px;">{c.desc}</p>
            <span style="color: #cc785c; font-size: 14px; font-weight: 500;">Calculate →</span>
          </a>
        ))}
      </div>
    </main>
  </body>
</html>
