---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CalcPage from "../../../components/CalcPage.astro";
import CacLtvCalc from "../../../components/react/CacLtvCalc";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  lang="en"
  title="Step 7: each customer — Calculators"
  description="Each customer should bring at least 3 times what they cost."
>
  <CalcPage
    lang="en"
    step={7}
    stepName="Each customer"
    lede="Each customer should bring at least 3 times what they cost to win."
    prevHref={`${base}en/calculators/npv-irr/`}
    prevLabel="Step 6: NPV and IRR"
    nextHref={`${base}en/calculators/sensitivity/`}
    nextLabel="Step 8: move numbers"
  >
    <CacLtvCalc lang="en" currency="USD" client:load />
  </CalcPage>
</BaseLayout>
