---
import "../styles/global.css";
import "../styles/route.css";

interface Props {
  title: string;
  description: string;
  lang: "es" | "en";
}

// Every internal URL goes through `base` (import.meta.env.BASE_URL).
// Hardcoding "/" links is the project-site blank-page bug: GitHub Pages
// serves this repo under /business-feasibility-toolkit/, not /.
const base = import.meta.env.BASE_URL;
const { title, description, lang } = Astro.props;
const other = lang === "es" ? "en" : "es";
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Inter:wght@400;500&family=JetBrains+Mono&display=swap"
      rel="stylesheet"
    />
    <script src={`${base}route.js`} defer></script>
    <title>{title}</title>
  </head>
  <body>
    <header class="topnav">
      <nav class="wrap" aria-label="Main">
        <a class="brand" href={`${base}${lang}/`}><span style="color: var(--primary)">✳</span> {lang === "es" ? "Mi ruta" : "My route"}</a>
        <div class="lang-switch">
          <span id="nav-progress" style="font-size: 0.875rem; color: var(--muted)">0 / 10</span>
          <a href={`${base}es/`} aria-current={lang === "es" ? "true" : undefined}>ES</a>
          <a href={`${base}en/`} aria-current={lang === "en" ? "true" : undefined}>EN</a>
          <a href={`${base}${other}/`} hreflang={other}>
            {other === "es" ? "Español" : "English"}
          </a>
        </div>
      </nav>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer>
      <div class="wrap">
        <p><span style="color: var(--primary)">✳</span> Business Feasibility Toolkit - {lang === "es" ? "gratis, sin cuentas, en tu navegador." : "free, no accounts, in your browser."}</p>
      </div>
    </footer>
  </body>
</html>
