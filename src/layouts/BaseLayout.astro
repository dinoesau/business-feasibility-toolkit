---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang: "es" | "en";
}

// Every internal URL goes through `base` (import.meta.env.BASE_URL).
// Hardcoding "/" links is the project-site blank-page bug: GitHub Pages
// serves this repo under /business-feasibility-toolkit/, not /.
const base = import.meta.env.BASE_URL;
const { title, description, lang } = Astro.props;
const other = lang === "es" ? "en" : "es";
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="topnav">
      <nav class="wrap" aria-label="Main">
        <a class="brand" href={`${base}${lang}/`}>Business Feasibility Toolkit</a>
        <div class="lang-switch">
          <a href={`${base}es/`} aria-current={lang === "es" ? "true" : undefined}>ES</a>
          <a href={`${base}en/`} aria-current={lang === "en" ? "true" : undefined}>EN</a>
          <a href={`${base}${other}/`} hreflang={other}>
            {other === "es" ? "Español" : "English"}
          </a>
        </div>
      </nav>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer>
      <div class="wrap">
        <p>Business Feasibility Toolkit - static ES/EN site.</p>
      </div>
    </footer>
  </body>
</html>
